# 复制为 .env 后给 docker compose 用。真正的 .env 不会进 git。
# cp .env.example .env

JWT_SECRET=change-me

S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key-dev
S3_BUCKET=kingei
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://127.0.0.1:3000

# 前后端拆开托管时取消注释。Docker 页面和 /api 同源时不要填。
# FRONTEND_ORIGIN=https://你的前端域名
# COOKIE_SAMESITE=none
